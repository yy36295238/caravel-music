{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "留声",
  "version": "0.1.0",
  "identifier": "com.liusheng.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "label": "main", "title": "留声", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src music: http://music.localhost https://music.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "只属于你的本地音乐播放器",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RjY1ODdFQ0REODE2QUUKUldTdUZ0ak5mbGoyU1BMVmJxSjc4NG1MUmNpWUxnSmJFU0hnNWJPdUJQVGQ1V2lwUEx6MStsVU4K",
      "endpoints": [
        "https://github.com/yy36295238/caravel-music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
